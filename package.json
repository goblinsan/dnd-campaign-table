{
  "name": "dnd-campaign-table",
  "version": "1.0.0",
  "description": "Role-aware D&D campaign table app with distinct DM/player/group views, map/surroundings context, NPC/mob visibility controls, and ambient audio support.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node index.ts",
    "test": "jest --testPathPatterns=tests/ --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goblinsan/dnd-campaign-table.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/goblinsan/dnd-campaign-table/issues"
  },
  "homepage": "https://github.com/goblinsan/dnd-campaign-table#readme",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
